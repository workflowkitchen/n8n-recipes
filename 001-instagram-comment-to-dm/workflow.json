    {
      "parameters": {
        "url": "={{ 'https://graph.instagram.com/' + $json.API_VERSION + '/' + $json.MEDIA_ID + '/comments' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,text,username,timestamp"
            },
            {
              "name": "limit",
              "value": "50"
            }
          ]
        },
        "options": {}
      },
      "id": "5b0d7d1e-0003-4a10-9a01-000000000003",
      "name": "Get comments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "notes": "First page only (50 comments per minute). Add pagination if one post gets more than that.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "id": "5b0d7d1e-0004-4a10-9a01-000000000004",
