      "typeVersion": 1,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "logic": "removeItemsWithAlreadySeenKeyValues",
        "dedupeValue": "={{ $json.id }}",
        "options": {}
      },
      "id": "5b0d7d1e-0005-4a10-9a01-000000000005",
      "name": "Only new comments",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "notes": "Without this, the same people get processed every minute.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a0000001-0000-4000-8000-000000000002",
              "leftValue": "={{ $json.username }}",
              "rightValue": "={{ $('Config').first().json.MY_USERNAME }}",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "5b0d7d1e-0006-4a10-9a01-000000000006",
      "name": "Not me?",
      "type": "n8n-nodes-base.if",
