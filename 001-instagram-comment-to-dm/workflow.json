              "type": "string"
            },
            {
              "id": "c0000001-0000-4000-8000-000000000002",
              "name": "MEDIA_ID",
              "value": "PASTE_YOUR_REEL_MEDIA_ID",
              "type": "string"
            },
            {
              "id": "c0000001-0000-4000-8000-000000000004",
              "name": "MY_USERNAME",
              "value": "your_instagram_username",
              "type": "string"
            },
            {
              "id": "c0000001-0000-4000-8000-000000000006",
              "name": "REPLY_TEXT",
              "value": "Sent! 📩 Check your DMs (or Requests if you don't follow me yet)",
